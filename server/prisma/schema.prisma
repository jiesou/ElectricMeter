// 表结构跟随 shared/types.ts

generator client {
  provider   = "prisma-client"
  output     = "../generated/prisma"
  runtime    = "bun"
  engineType = "client"
}

datasource db {
  provider = "sqlite"
}
model Device {
  id       String   @id
  name     String
  ip       String?
  entities Entity[]
}

model Entity {
  device_id  String
  id         String
  name       String
  type       String
  state      Boolean?
  powerW     Float?
  energyKwh  Float?
  lastUpdate Int?
  device     Device  @relation(fields: [device_id], references: [id], onDelete: Cascade)

  @@id([device_id, id])
}
