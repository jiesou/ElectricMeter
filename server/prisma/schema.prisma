// 表结构。运行期不加载 Prisma Client——建表和查询都走 core/db.ts 的手写 SQL。
// 这份文件给 Prisma Studio 看、给未来迁移用；改了这里记得同步 core/db.ts 里的 SCHEMA。
generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "sqlite"
}

/// 一台下位机 = 一个 ESP32，管一间房
model Device {
  id         String @id
  name       String
  model      String?
  fwVersion  String?
  lastSeen   Int    @default(0)
}

/// 开关的状态变化历史。只记 domain=switch —— 高频读数进 statistics，不进这里
model State {
  deviceId  String
  key       String
  ts        Int
  state     String
  requested Int?

  @@id([deviceId, key, ts])
  @@index([ts])
}

/// 时间桶聚合。原始样本一律不落盘，这张表就是全部历史
model Statistics {
  deviceId    String
  key         String
  bucketStart Int
  mean        Float
  min         Float
  max         Float
  sum         Float

  @@id([deviceId, key, bucketStart])
  @@index([bucketStart])
}
