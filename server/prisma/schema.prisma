// 表结构跟随 shared/types.ts

generator client {
  provider   = "prisma-client"
  output     = "../generated/prisma"
  runtime    = "bun"
  engineType = "client"
}

datasource db {
  provider = "sqlite"
}
model Device {
  id       String   @id
  name     String
  ip       String?
  entities Entity[]
}

model Entity {
  device_id  String
  id         String
  name       String
  type       String
  state      Boolean?
  powerW     Float?
  energyKwh  Float?
  inCount    Int?
  outCount   Int?
  netCount   Int?
  ts         Float?
  device     Device          @relation(fields: [device_id], references: [id], onDelete: Cascade)
  history    EntityHistory[]

  @@id([device_id, id])
}

// Entity 的历史读数，只留最近 10 分钟（窗口见 core/history.ts）
model EntityHistory {
  device_id String
  id        String
  ts        Float
  powerW    Float
  entity    Entity @relation(fields: [device_id, id], references: [device_id, id], onDelete: Cascade)

  @@id([device_id, id, ts])
  @@index([device_id, ts])
}
