// 表结构 = shared/types.ts 的模型：设备、实体两行身份。
// 实时读数（开关通断、功率、电量）不落库，只在内存里。
generator client {
  provider   = "prisma-client"
  output     = "../generated/prisma"
  runtime    = "bun"
  engineType = "client"
}

datasource db {
  provider = "sqlite"
}

/// 一台下位机 = 一个 ESP32，管一间房。online / lastSeen 是运行时的，不落库
model Device {
  id       String   @id
  name     String
  ip       String?
  entities Entity[]
}

/// 实体：一个回路的开关，或它的功率表。id 是设备侧的名字，没有第二套命名
model Entity {
  device_id String
  id        String
  name      String
  type      String
  device    Device @relation(fields: [device_id], references: [id], onDelete: Cascade)

  @@id([device_id, id])
}
