import { Palette, ScrollView } from "std-widgets.slint";
import { AppData } from "app-data.slint";
import { LineLabel, PeoplePageData, RoomRow } from "people-page-data.slint";
import { CameraViewport } from "components/camera-viewport.slint";
import { PageHeader } from "components/page-header.slint";
import { Sizing } from "sizing.slint";

component RoomLine inherits Rectangle {
    in property<RoomRow> info;
    callback clicked();

    height: Sizing.small * 130%;
    border-radius: Sizing.small * 25%;
    background: info.selected ? Palette.accent-background.with-alpha(20%) : Palette.foreground.with-alpha(6%);

    HorizontalLayout {
        padding-left: Sizing.small * 30%;
        padding-right: Sizing.small * 30%;
        spacing: Sizing.small * 15%;

        VerticalLayout {
            horizontal-stretch: 1;
            alignment: center;
            spacing: Sizing.small * 6%;

            Text {
                text: info.name;
                color: Palette.foreground;
                font-weight: 700;
                font-size: Sizing.small * 38%;
            }

            Text {
                overflow: elide; // 数字再长也省略，不能把面板撑出横向滚动
                text: info.lined
                      ? "进 " + info.in-count + " · 出 " + info.out-count
                      : (PeoplePageData.calibrating ? "点一下加线" : "未标定");
                color: info.lined ? Palette.foreground.with-alpha(55%) : Palette.foreground.with-alpha(40%);
                font-size: Sizing.small * 28%;
            }
        }

        // 人数：一眼要看的就是它，进出只是注脚
        HorizontalLayout {
            alignment: end;
            spacing: Sizing.small * 6%;

            if info.lined : Text {
                vertical-alignment: center;
                text: info.net;
                color: Palette.accent-background;
                font-weight: 700;
                font-size: Sizing.small * 70%;
            }

            if info.lined : VerticalLayout {
                alignment: end;
                padding-bottom: Sizing.small * 12%;

                Text {
                    text: "人";
                    color: Palette.foreground.with-alpha(55%);
                    font-size: Sizing.small * 30%;
                }
            }
        }
    }

    touch := TouchArea {
        clicked => { root.clicked(); }
    }
}

component ControlRow inherits Rectangle {
    in property<string> label: "";
    in property<string> value: "";
    in property<bool> highlighted: false;
    in property<bool> enabled: true;
    callback clicked();

    height: Sizing.small * 110%;
    border-radius: Sizing.small * 30%;
    background: touch.has-hover && enabled ? Palette.foreground.with-alpha(15%) : Palette.foreground.with-alpha(7%);
    border-width: 1px;
    border-color: highlighted ? Palette.accent-background : transparent;

    HorizontalLayout {
        padding-left: Sizing.small * 35%;
        padding-right: Sizing.small * 35%;

        Text {
            vertical-alignment: center;
            text: root.label;
            color: root.enabled ? Palette.foreground : Palette.foreground.with-alpha(35%);
        }

        Text {
            horizontal-stretch: 1;
            horizontal-alignment: right;
            vertical-alignment: center;
            text: root.value;
            color: root.enabled ? Palette.accent-background : Palette.foreground.with-alpha(35%);
        }
    }

    touch := TouchArea {
        clicked => { if (root.enabled) { root.clicked(); } }
    }
}

export component PeoplePage {
    HorizontalLayout {
        width: 100%;
        height: 100%;
        padding: 0px;
        spacing: 0px;

        VerticalLayout {
            width: 74%;
            padding: 0px;
            spacing: 0px;

            PageHeader {
                title: "人数监控";
            }

            Rectangle {
                vertical-stretch: 1;

                viewport := CameraViewport {
                    width: 100%;
                    height: 100%;
                    frame <=> PeoplePageData.camera-frame;
                    // 只在这页渲染画面：切走就停这个 16ms 定时器，推理与上报照跑
                    running: AppData.current-tab == 1;
                    request-camera-frame => { PeoplePageData.request-camera-frame(); }
                }

                // 房号标签贴在自己房间那侧（判定线的「内」侧），运行态也画：一眼看出哪条线是哪间房、方向对不对
                for label in PeoplePageData.labels : Text {
                    x: viewport.view-x + label.x * viewport.draw-w + 8px;
                    y: viewport.view-y + label.y * viewport.draw-h - 14px;
                    text: label.name;
                    color: label.selected ? Palette.foreground : Palette.foreground.with-alpha(70%);
                }

                // 标定态：画面上叠把手（线本身还是 OpenCV 画在帧里的）
                if PeoplePageData.calibrating : Rectangle {
                    width: 100%;
                    height: 100%;

                    if PeoplePageData.selected >= 0 : Rectangle {
                        width: Sizing.small * 60%;
                        height: self.width;
                        border-radius: self.width / 2;
                        background: Palette.accent-background;
                        border-width: 3px;
                        border-color: Palette.accent-foreground;
                        x: viewport.view-x + PeoplePageData.ax * viewport.draw-w - self.width / 2;
                        y: viewport.view-y + PeoplePageData.ay * viewport.draw-h - self.height / 2;
                    }

                    if PeoplePageData.selected >= 0 : Rectangle {
                        width: Sizing.small * 60%;
                        height: self.width;
                        border-radius: self.width / 2;
                        background: Palette.accent-background;
                        border-width: 3px;
                        border-color: Palette.accent-foreground;
                        x: viewport.view-x + PeoplePageData.bx * viewport.draw-w - self.width / 2;
                        y: viewport.view-y + PeoplePageData.by * viewport.draw-h - self.height / 2;
                    }

                    touch := TouchArea {
                        width: 100%;
                        height: 100%;
                        pointer-event(e) => {
                            if (e.kind == PointerEventKind.down) {
                                PeoplePageData.press((touch.mouse-x - viewport.view-x) / viewport.draw-w,
                                                     (touch.mouse-y - viewport.view-y) / viewport.draw-h);
                            }
                            if (e.kind == PointerEventKind.up) {
                                PeoplePageData.release();
                            }
                        }
                        moved => {
                            PeoplePageData.drag((touch.mouse-x - viewport.view-x) / viewport.draw-w,
                                                (touch.mouse-y - viewport.view-y) / viewport.draw-h);
                        }
                    }
                }
            }
        }

        Rectangle {
            width: 26%;
            background: Palette.alternate-background;
            border-color: Palette.border;
            border-width: 1px;

            VerticalLayout {
                padding: Sizing.small * 20%;
                padding-top: Sizing.small * 140%; // 让开右上角那三个窗口按钮
                spacing: Sizing.small * 20%;

                ScrollView {
                    mouse-drag-pan-enabled: true;
                    vertical-stretch: 1;

                    VerticalLayout {
                        spacing: Sizing.small * 15%;

                        if PeoplePageData.rooms.length == 0 : Text {
                            text: "没有房间数据";
                            color: Palette.foreground.with-alpha(45%);
                            font-size: Sizing.small * 30%;
                        }

                        for room in PeoplePageData.rooms : RoomLine {
                            info: room;
                            clicked => { PeoplePageData.room-clicked(room.id); }
                        }
                    }
                }

                if PeoplePageData.calibrating : ControlRow {
                    label: "删除这条线";
                    enabled: PeoplePageData.selected >= 0;
                    clicked => { PeoplePageData.remove-line(); }
                }

                if PeoplePageData.calibrating : ControlRow {
                    label: "完成";
                    value: "保存并退出";
                    highlighted: true;
                    clicked => { PeoplePageData.close-calibration(); }
                }

                if !PeoplePageData.calibrating : ControlRow {
                    label: "标定判定线";
                    value: "›";
                    clicked => { PeoplePageData.open-calibration(); }
                }

                if !PeoplePageData.calibrating : ControlRow {
                    label: "UDP 图传";
                    value: PeoplePageData.streaming ? "开" : "关";
                    highlighted: PeoplePageData.streaming;
                    clicked => { PeoplePageData.toggle-stream(); }
                }

                if !PeoplePageData.calibrating : ControlRow {
                    label: "清零";
                    value: "进 / 出";
                    clicked => { PeoplePageData.reset-counts(); }
                }
            }
        }
    }
}
