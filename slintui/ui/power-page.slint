import { Palette, ScrollView } from "std-widgets.slint";
import { EntityCard, PowerPageData, Room } from "power-page-data.slint";
import { PageHeader } from "components/page-header.slint";
import { PowerGauge } from "components/power-gauge.slint";
import { Sizing } from "sizing.slint";

component Card inherits Rectangle {
    border-radius: Sizing.small * 40%;
    background: Palette.background;
    border-width: 1px;
    border-color: Palette.border.with-alpha(60%);
}

component MeterCard inherits Card {
    in property<EntityCard> entity;

    VerticalLayout {
        padding: Sizing.small * 25%;
        spacing: 0px;

        Text {
            text: root.entity.name;
            color: Palette.foreground.with-alpha(70%);
        }

        PowerGauge {
            value: root.entity.power;
        }

        Text {
            text: "累计 " + root.entity.energy + " kWh";
            color: Palette.foreground.with-alpha(55%);
            horizontal-alignment: center;
        }
    }
}

component SwitchCard inherits Card {
    in property<EntityCard> entity;

    VerticalLayout {
        padding: Sizing.small * 25%;
        spacing: Sizing.small * 35%;

        Text {
            text: root.entity.name;
            color: Palette.foreground.with-alpha(70%);
        }

        Rectangle {
            vertical-stretch: 1;

            Rectangle {
                width: Sizing.small * 125%;
                height: Sizing.small * 225%;
                border-radius: self.width / 2;
                background: root.entity.state ? Palette.accent-background.with-alpha(25%) : Palette.foreground.with-alpha(8%);
                border-width: 2px;
                border-color: root.entity.state ? Palette.accent-background : Palette.foreground.with-alpha(20%);
                animate background, border-color { duration: 200ms; }

                Rectangle {
                    y: root.entity.state ? Sizing.small * 15% : parent.height - self.height - Sizing.small * 15%;
                    width: Sizing.small * 95%;
                    height: self.width;
                    border-radius: self.width / 2;
                    background: root.entity.state ? Palette.accent-background : Palette.foreground.with-alpha(45%);
                    animate y, background { duration: 200ms; easing: ease-out; }
                }
            }
        }

        Text {
            text: root.entity.state ? "通电" : "断开";
            color: root.entity.state ? Palette.accent-background : Palette.foreground.with-alpha(50%);
            font-weight: 700;
            horizontal-alignment: center;
        }
    }
}

component RoomCard inherits Rectangle {
    in property<Room> room;
    border-radius: Sizing.small * 50%;
    background: Palette.alternate-background;
    border-width: 1px;
    border-color: Palette.border.with-alpha(60%);

    VerticalLayout {
        padding: Sizing.small * 35%;
        spacing: Sizing.small * 25%;

        HorizontalLayout {
            spacing: Sizing.small * 25%;

            Rectangle {
                width: Sizing.small * 25%;
                height: self.width;
                y: (parent.height - self.height) / 2;
                border-radius: self.width / 2;
                background: root.room.online ? Palette.accent-background : Palette.foreground.with-alpha(30%);
            }

            Text {
                text: root.room.name;
                color: Palette.foreground;
                font-weight: 700;
                vertical-alignment: center;
            }

            Text {
                text: root.room.online ? "在线" : "离线";
                color: Palette.foreground.with-alpha(50%);
                vertical-alignment: center;
                horizontal-stretch: 1;
            }

            Text {
                text: root.room.power + " W";
                color: Palette.foreground;
                font-weight: 700;
                vertical-alignment: center;
            }

            Text {
                text: "· 累计 " + root.room.energy + " kWh";
                color: Palette.foreground.with-alpha(55%);
                vertical-alignment: center;
            }
        }

        if root.room.entities.length == 0 : Text {
            text: "^_^";
            color: Palette.foreground.with-alpha(50%);
        }

        // 实体多了就横向滑：视口高度 = 实体卡 + 横向滚动条那一条，纵向没有可滚的量
        if root.room.entities.length > 0 : ScrollView {
            height: Sizing.screen-width * 20% + Sizing.small * 30%;

            HorizontalLayout {
                alignment: start;
                spacing: Sizing.small * 25%;

                for entity in root.room.entities : Rectangle {
                    width: entity.type == "meter" ? Sizing.screen-width * 17% : Sizing.screen-width * 11%;
                    height: Sizing.screen-width * 20%;

                    if entity.type == "meter" : MeterCard { entity: entity; }
                    if entity.type == "switch" : SwitchCard { entity: entity; }
                }
            }
        }
    }
}

export component PowerPage {
    VerticalLayout {
        width: 100%;
        height: 100%;
        padding: 0px;
        spacing: 0px;

        PageHeader {
            title: "客房用电";
        }

        ScrollView {
            VerticalLayout {
                alignment: start;
                padding: Sizing.small * 50%;
                padding-top: Sizing.small * 10%;
                spacing: Sizing.small * 40%;

                for room in PowerPageData.rooms : RoomCard { room: room; }
            }
        }
    }
}
