import { Palette, ScrollView } from "std-widgets.slint";
import { PageHeader } from "page-header.slint";
import { PowerGauge } from "power-gauge.slint";

export struct EntityCard {
    name: string,
    type: string,
    state: bool,
    power: float,
    energy: string,
}

export struct Room {
    name: string,
    online: bool,
    power: string,
    energy: string,
    entities: [EntityCard],
}

export global PowerPageData {
    in-out property<[Room]> rooms: [];
    in-out property<string> server: "";
    in-out property<string> updated: "";
    callback refresh();
}

component Card inherits Rectangle {
    border-radius: 20px;
    background: Palette.background;
    border-width: 1px;
    border-color: Palette.border.with-alpha(60%);
}

component MeterCard inherits Card {
    in property<EntityCard> entity;

    VerticalLayout {
        padding: 14px;
        spacing: 0px;

        Text {
            text: root.entity.name;
            color: Palette.foreground.with-alpha(70%);
            font-size: 18px;
        }

        PowerGauge {
            value: root.entity.power;
        }

        Text {
            text: "累计 " + root.entity.energy + " kWh";
            color: Palette.foreground.with-alpha(55%);
            font-size: 16px;
            horizontal-alignment: center;
        }
    }
}

component SwitchCard inherits Card {
    in property<EntityCard> entity;

    VerticalLayout {
        padding: 14px;
        spacing: 18px;

        Text {
            text: root.entity.name;
            color: Palette.foreground.with-alpha(70%);
            font-size: 18px;
        }

        Rectangle {
            vertical-stretch: 1;

            Rectangle {
                width: 64px;
                height: 116px;
                border-radius: 32px;
                background: root.entity.state ? Palette.accent-background.with-alpha(25%) : Palette.foreground.with-alpha(8%);
                border-width: 2px;
                border-color: root.entity.state ? Palette.accent-background : Palette.foreground.with-alpha(20%);
                animate background, border-color { duration: 200ms; }

                Rectangle {
                    y: root.entity.state ? 8px : parent.height - self.height - 8px;
                    width: 48px;
                    height: 48px;
                    border-radius: 24px;
                    background: root.entity.state ? Palette.accent-background : Palette.foreground.with-alpha(45%);
                    animate y, background { duration: 200ms; easing: ease-out; }
                }
            }
        }

        Text {
            text: root.entity.state ? "通电" : "断开";
            color: root.entity.state ? Palette.accent-background : Palette.foreground.with-alpha(50%);
            font-size: 22px;
            font-weight: 700;
            horizontal-alignment: center;
        }
    }
}

component RoomCard inherits Rectangle {
    in property<Room> room;
    border-radius: 26px;
    background: Palette.alternate-background;
    border-width: 1px;
    border-color: Palette.border.with-alpha(60%);

    VerticalLayout {
        padding: 18px;
        spacing: 14px;

        HorizontalLayout {
            spacing: 12px;

            Rectangle {
                width: 12px;
                height: 12px;
                y: (parent.height - self.height) / 2;
                border-radius: 6px;
                background: root.room.online ? Palette.accent-background : Palette.foreground.with-alpha(30%);
            }

            Text {
                text: root.room.name;
                color: Palette.foreground;
                font-size: 26px;
                font-weight: 700;
                vertical-alignment: center;
            }

            Text {
                text: root.room.online ? "在线" : "离线";
                color: Palette.foreground.with-alpha(50%);
                font-size: 18px;
                vertical-alignment: center;
                horizontal-stretch: 1;
            }

            Text {
                text: root.room.power + " W";
                color: Palette.foreground;
                font-size: 26px;
                font-weight: 700;
                vertical-alignment: center;
            }

            Text {
                text: "· 累计 " + root.room.energy + " kWh";
                color: Palette.foreground.with-alpha(55%);
                font-size: 18px;
                vertical-alignment: center;
            }
        }

        if root.room.entities.length == 0 : Text {
            text: "未申报回路";
            color: Palette.foreground.with-alpha(50%);
            font-size: 20px;
        }

        // 实体多了就横向滑
        if root.room.entities.length > 0 : ScrollView {
            height: 266px;

            HorizontalLayout {
                alignment: start;
                spacing: 14px;
                padding-bottom: 16px;

                for entity in root.room.entities : Rectangle {
                    width: entity.type == "meter" ? 220px : 140px;
                    height: 250px;

                    if entity.type == "meter" : MeterCard { entity: entity; }
                    if entity.type == "switch" : SwitchCard { entity: entity; }
                }
            }
        }
    }
}

export component PowerPage {
    VerticalLayout {
        padding: 0px;
        spacing: 0px;

        PageHeader {
            title: "客房用电";
        }

        ScrollView {
            VerticalLayout {
                alignment: start;
                padding: 24px;
                padding-top: 6px;
                spacing: 20px;

                for room in PowerPageData.rooms : RoomCard { room: room; }
            }
        }

        Text {
            height: 34px;
            x: 24px;
            vertical-alignment: center;
            text: PowerPageData.updated + "  ·  " + PowerPageData.server;
            color: Palette.foreground.with-alpha(45%);
            font-size: 16px;
        }
    }
}
