import { Palette } from "std-widgets.slint";
import { PeoplePageData } from "people-page-data.slint";
import { PowerPageData } from "power-page-data.slint";
import { SettingsPageData } from "settings-page-data.slint";
import { NavBar } from "components/nav-bar.slint";
import { PeoplePage } from "people-page.slint";
import { PowerPage } from "power-page.slint";
import { SettingsPage } from "settings-page.slint";
import { Sizing } from "sizing.slint";

export { PeoplePageData, PowerPageData, SettingsPageData }

component WindowButton inherits Rectangle {
    in property<string> label: "";
    callback clicked();

    width: Sizing.large;
    height: Sizing.small;
    border-radius: Sizing.small * 30%;
    background: touch.has-hover ? Palette.foreground.with-alpha(15%) : Palette.foreground.with-alpha(7%);

    Text {
        text: root.label;
        color: Palette.foreground;
        horizontal-alignment: center;
        vertical-alignment: center;
    }

    touch := TouchArea {
        clicked => { root.clicked(); }
    }
}

export global AppData {
    in-out property<int> current-tab: 1;
    callback stop-app();
    callback swap-cameras();
    callback tab-changed(int);
    callback toggle-mock();
}

export component AppWindow inherits Window {
    title: "民宿用电管理";
    height: Sizing.screen-height;
    width: Sizing.screen-width;
    default-font-size: root.width < 801px ? 14px : 24px;
    init => {
        Palette.color-scheme = ColorScheme.dark;
        keys.focus();
    }

    // Home 键全窗口切换 mock，其余按键照常放行
    keys := FocusScope {
        width: 100%;
        height: 100%;

        key-pressed(event) => {
            if (event.text == Key.Home) {
                AppData.toggle-mock();
                return accept;
            }
            return reject;
        }

        VerticalLayout {
            width: 100%;
            height: 100%;
            padding: 0px;
            spacing: 0px;

            Rectangle {
                width: 100%;
                vertical-stretch: 1;
                clip: true;

                if AppData.current-tab == 0 : PowerPage {
                    width: 100%;
                    height: 100%;
                }
                if AppData.current-tab == 1 : PeoplePage {
                    width: 100%;
                    height: 100%;
                }
                if AppData.current-tab == 2 : SettingsPage {
                    width: 100%;
                    height: 100%;
                }
            }

            NavBar {
                height: Sizing.small * 110%;
                current-index <=> AppData.current-tab;
                tabs: ["客房用电", "人数监控", "设置"];
                tab-changed(index) => {
                    AppData.tab-changed(index);
                }
            }
        }
    }

    HorizontalLayout {
        x: 0;
        y: Sizing.small * 25%;
        width: 100%;
        height: Sizing.small;
        alignment: end;
        padding-right: Sizing.small * 40%;
        spacing: Sizing.small * 25%;

        WindowButton {
            label: "⇄";
            clicked => { AppData.swap-cameras(); }
        }
        WindowButton {
            label: (Palette.color-scheme == ColorScheme.light) ? "🌣" : "☽";
            clicked => {
                Palette.color-scheme = (Palette.color-scheme == ColorScheme.light) ? ColorScheme.dark : ColorScheme.light;
            }
        }
        WindowButton {
            label: "X";
            clicked => { AppData.stop-app(); }
        }
    }

    power-refresh := Timer {
        interval: 1000ms;
        running: true;
        triggered => {
            PowerPageData.refresh();
        }
    }
}
