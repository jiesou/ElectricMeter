export struct EntityCard {
    name: string,
    type: string,
    state: bool,
    power: float,
    energy: string,
}

export struct People {
    in: int,
    out: int,
    net: int,
    counted: bool,
}

export struct Room {
    id: string,
    name: string,
    online: bool,
    power: string,
    energy: string,
    entities: [EntityCard],
    people: People,
}

